<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/home_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="臺灣公路通"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIconTint="?attr/colorOnPrimary"/>

        <ScrollView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:fillViewport="true"
            android:background="?android:attr/colorBackground"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="道路資訊，一目了然"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查詢即時路況與常用公路服務"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freeway"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginBottom="24dp"
                    android:text="查看即時路況"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:backgroundTint="?attr/colorPrimary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_traffic"
                    app:iconGravity="textTop"
                    app:iconSize="32dp"
                    app:iconPadding="10dp"
                    app:iconTint="?attr/colorOnPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="常用服務"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="28dp">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_oil"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="油價"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"
                        android:backgroundTint="?attr/colorSurface"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_fuel"
                        app:iconGravity="textTop"
                        app:iconSize="26dp"
                        app:iconPadding="8dp"
                        app:iconTint="@color/home_secondary_accent"
                        app:strokeColor="@color/home_secondary_accent"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_camera"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:text="攝影機"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"
                        android:backgroundTint="?attr/colorSurface"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="textTop"
                        app:iconSize="26dp"
                        app:iconPadding="8dp"
                        app:iconTint="@color/home_secondary_accent"
                        app:strokeColor="@color/home_secondary_accent"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_etag"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="eTag"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"
                        android:backgroundTint="?attr/colorSurface"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_etag"
                        app:iconGravity="textTop"
                        app:iconSize="26dp"
                        app:iconPadding="8dp"
                        app:iconTint="@color/home_secondary_accent"
                        app:strokeColor="@color/home_secondary_accent"/>


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="經典功能"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_oldroad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="舊版路況"
                    android:textSize="14sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/home_secondary_accent"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header"/>

</androidx.drawerlayout.widget.DrawerLayout>
