<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.leerongmao.taiwanhighway">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_taiwan_road"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_taiwan_road_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaiwanHighway">
        <activity
            android:name="com.leerongmao.taiwanhighway.EtagActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.CameraActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.OilActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.HighwayMainActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.HighwayActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.TrafficDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.OldRoadActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.FreewayActivity"
            android:exported="false" />
        <activity
            android:name="com.leerongmao.taiwanhighway.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TaiwanHighway_NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>